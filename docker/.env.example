# ==================== PRODUCTION ENVIRONMENT CONFIGURATION ====================
# Copy this file to .env and update with your actual values

# ==================== DATABASE CONFIGURATION ====================
POSTGRES_DB=trading_system
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=secure_password_change_me_2025

# ==================== CACHE CONFIGURATION ====================
REDIS_PASSWORD=redis_secure_change_me_2025

# ==================== APPLICATION CONFIGURATION ====================
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production

# ==================== API KEYS ====================
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Abacus.AI Configuration
ABACUS_AI_API_KEY=your-abacus-ai-api-key-here
ABACUS_AI_BASE_URL=https://api.abacus.ai

# Letta Configuration
LETTA_API_KEY=your-letta-api-key-here

# ==================== INTEGRATION TOKENS ====================
# GitHub Integration
GITHUB_TOKEN=your-github-token-here

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Telegram Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Notion Integration
NOTION_API_KEY=your-notion-integration-token-here

# QuantConnect Integration
QUANTCONNECT_API_KEY=your-quantconnect-api-key-here

# ==================== SECURITY CONFIGURATION ====================
ENCRYPTION_KEY=your-32-byte-encryption-key-change-me

# ==================== MONITORING CONFIGURATION ====================
# Grafana Admin Password
GRAFANA_PASSWORD=admin123_change_me

# ==================== CORS CONFIGURATION ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ==================== MQTT CONFIGURATION ====================
MQTT_BROKER_URL=mqtt://mosquitto:1883

# ==================== EXTERNAL SERVICES ====================
# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password

# AWS Configuration (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ==================== PERFORMANCE TUNING ====================
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis configuration
REDIS_MAX_CONNECTIONS=100
REDIS_TIMEOUT=5

# Application scaling
MAX_WORKERS=4
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# ==================== LOGGING CONFIGURATION ====================
LOG_FORMAT=json
LOG_FILE_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_RETENTION_DAYS=30

# ==================== SECURITY HEADERS ====================
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=86400

# ==================== RATE LIMITING ====================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ==================== HEALTH CHECK CONFIGURATION ====================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60

# ==================== BACKUP CONFIGURATION ====================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1