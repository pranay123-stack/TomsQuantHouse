# LangGraph API Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./langgraph.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/langgraph
# For MySQL: mysql+asyncmy://user:password@localhost:3306/langgraph

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_PREMIUM=500
RATE_LIMIT_STANDARD=200
RATE_LIMIT_BASIC=100

# Workflow Configuration
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_TIMEOUT_MINUTES=60
CHECKPOINT_RETENTION_DAYS=30
MAX_WORKFLOWS_PER_USER=100
MAX_BATCH_SIZE=50
MAX_STATE_SIZE_MB=10

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_RETENTION_HOURS=168
PROMETHEUS_PORT=9090

# Alert Thresholds
FAILURE_RATE_THRESHOLD=0.10
AVG_EXECUTION_TIME_THRESHOLD=300
MEMORY_USAGE_THRESHOLD=0.80
ACTIVE_WORKFLOW_LIMIT=50

# Authentication
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
MAX_WEBSOCKET_CONNECTIONS=1000

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# External Services
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@langgraph.local

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIRECTORY=./uploads
ALLOWED_FILE_EXTENSIONS=["json", "yaml", "txt", "csv"]

# LangGraph Specific
LANGGRAPH_CHECKPOINT_INTERVAL=30
LANGGRAPH_STATE_PERSISTENCE=true
LANGGRAPH_ENABLE_PERSISTENCE=true

# Development
AUTO_RELOAD=true
RELOAD_DIRS=./app

# Production Optimizations
WORKERS=4
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100