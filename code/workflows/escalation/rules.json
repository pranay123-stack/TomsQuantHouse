{
  "escalation_rules": {
    "trigger_conditions": {
      "financial_loss_threshold": {
        "threshold": 0.05,
        "period": "daily",
        "action": "immediate_escalation"
      },
      "risk_level_critical": {
        "condition": "risk_level == 'critical'",
        "action": "emergency_escalation"
      },
      "consecutive_failures": {
        "count": 3,
        "timeframe": "1h",
        "action": "standard_escalation"
      },
      "confidence_below_threshold": {
        "threshold": 0.3,
        "required_approvals": 2,
        "action": "enhanced_review"
      },
      "large_position_threshold": {
        "position_value": 5000000,
        "action": "management_escalation"
      },
      "volatility_spike": {
        "volatility_increase": 0.5,
        "timeframe": "5m",
        "action": "risk_escalation"
      }
    },
    "escalation_levels": [
      {
        "level": 1,
        "name": "Supervisor Review",
        "description": "Standard supervisor review required",
        "timeout_minutes": 15,
        "required_approvers": ["trading_supervisor"],
        "notification_channels": ["email", "dashboard"],
        "escalation_on_timeout": true
      },
      {
        "level": 2,
        "name": "Manager Escalation",
        "description": "Trading manager review required",
        "timeout_minutes": 10,
        "required_approvers": ["trading_manager", "risk_manager"],
        "notification_channels": ["email", "sms", "dashboard"],
        "escalation_on_timeout": true,
        "requires_acknowledgment": true
      },
      {
        "level": 3,
        "name": "Senior Management",
        "description": "Senior management approval required",
        "timeout_minutes": 5,
        "required_approvers": ["head_of_trading", "chief_risk_officer"],
        "notification_channels": ["phone", "email", "sms", "dashboard"],
        "escalation_on_timeout": true,
        "mandatory_attendance": true
      },
      {
        "level": 4,
        "name": "Executive Escalation",
        "description": "C-level executive approval required",
        "timeout_minutes": 3,
        "required_approvers": ["ceo", "cto", "cfo"],
        "notification_channels": ["phone", "sms", "emergency_broadcast"],
        "escalation_on_timeout": false,
        "emergency_protocol": true
      }
    ],
    "notification_templates": {
      "level_1": {
        "subject": "Trading Decision Review Required",
        "message": "A trading decision requires supervisor review. Workflow ID: {workflow_id}",
        "urgency": "medium"
      },
      "level_2": {
        "subject": "URGENT: Management Escalation Required",
        "message": "Critical trading decision requires management approval. Immediate action required.",
        "urgency": "high"
      },
      "level_3": {
        "subject": "CRITICAL: Senior Management Approval Required",
        "message": "EMERGENCY: Critical trading decision requires senior management approval within 5 minutes.",
        "urgency": "critical"
      },
      "level_4": {
        "subject": "EMERGENCY: Executive Approval Required",
        "message": "EMERGENCY: Critical situation requires immediate executive intervention.",
        "urgency": "emergency"
      }
    },
    "escalation_paths": {
      "financial_loss": ["level_2", "level_3"],
      "risk_critical": ["level_3", "level_4"],
      "large_position": ["level_1", "level_2", "level_3"],
      "volatility_spike": ["level_2", "level_3"],
      "system_failure": ["level_3", "level_4"]
    },
    "override_conditions": {
      "emergency_protocol": {
        "enabled": true,
        "trigger": "market_crisis",
        "auto_escalate": true,
        "bypass_normal_processes": true
      },
      "time_sensitive": {
        "enabled": true,
        "trigger": "execution_window_closing",
        "accelerated_escalation": true,
        "timeout_reduction": 0.5
      }
    }
  }
}