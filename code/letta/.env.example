# Environment Variables for Letta Server
# Copy this file to .env and fill in your actual values

# Letta Server Configuration
LETTA_SERVER_HOST=0.0.0.0
LETTA_SERVER_PORT=8283
LETTA_API_PORT=5000
LETTA_DATA_DIR=/app/data
LETTA_LOG_LEVEL=INFO
LETTA_API_KEY=your-secret-api-key-here

# Database Configuration
LETTA_PERSIST_TYPE=postgres
LETTA_POSTGRES_URL=postgresql://letta:letta_password@postgres:5432/letta_db

# Redis Configuration
LETTA_REDIS_URL=redis://redis:6379/0

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PostgreSQL Configuration
POSTGRES_DB=letta_db
POSTGRES_USER=letta
POSTGRES_PASSWORD=letta_password

# Redis Configuration
REDIS_PASSWORD=redis_password

# Agent Creation Configuration
CREATE_TRADING_AGENTS=true
AGENT_SPECIALIZATIONS=trading,market_analysis,risk_management

# Memory Configuration
MAX_MEMORY_BLOCKS_PER_AGENT=100
MEMORY_RETENTION_DAYS=365