# Redis Configuration Environment Variables
# Copy this file to .env and update with your actual values

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=trading_framework_2025
REDIS_DB=0

# Redis Container Configuration
REDIS_CONTAINER_NAME=trading-redis
REDIS_IMAGE=redis:7.2-alpine

# Database Configurations
REDIS_DB0_NAME=predictions_cache
REDIS_DB1_NAME=agent_memory
REDIS_DB2_NAME=graph_state
REDIS_DB3_NAME=entity_memory

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=300
ENABLE_EMAIL_ALERTS=false
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your_email@example.com
ALERT_EMAIL_PASSWORD=your_app_password
ALERT_EMAIL_RECIPIENTS=admin@example.com,team@example.com

# Performance Thresholds
MAX_MEMORY_USAGE_PERCENT=80
MIN_HIT_RATIO_PERCENT=80
MAX_RESPONSE_TIME_MS=100

# Docker Configuration
DOCKER_NETWORK=trading-redis-network
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_IMAGE=rediscommander/redis-commander:latest

# Pub/Sub Channels
TRADE_SIGNALS_CHANNEL=trade_signals
MARKET_UPDATES_CHANNEL=market_updates
ALERTS_CHANNEL=alerts
STRATEGY_UPDATES_CHANNEL=strategy_updates

# Logging
LOG_LEVEL=INFO
LOG_FILE=redis_health.log